# Copy this file to .env and fill in your real values for LOCAL testing.
# In GitHub Actions, set these as repository Secrets instead.
# NEVER commit a real .env file to git — it's already in .gitignore.

# Your QQ email address (sender)
SMTP_USER=your-email@qq.com

# QQ Mail SMTP authorization code (NOT your QQ login password!).
# Generate at: QQ Mail web → Settings → Accounts → IMAP/SMTP service
# IMPORTANT: If this code was ever exposed (sent in chat, committed by mistake, etc.)
# regenerate it immediately by toggling the IMAP/SMTP service off and on.
SMTP_PASS=your_authorization_code_here

# Recipient address (defaults to SMTP_USER if omitted)
RECIPIENT=your-email@qq.com

# How many days back to fetch (default 8 covers a full weekly cycle)
DAYS_BACK=8

# Optional SMTP overrides (only set if you need to use a non-QQ provider)
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
